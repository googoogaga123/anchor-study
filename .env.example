# Copy to .env and fill in. .env is gitignored; never commit a key.
OPENAI_API_KEY=sk-...

# Website (web/auth.py). The login service, WorkOS AuthKit: from the WorkOS dashboard.
# With these set, the development sign-in is off unless DEV_LOGIN=1.
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...
# Optional: where AuthKit returns to (default: this site's /callback). Add it under Redirects in WorkOS too.
# WORKOS_REDIRECT_URI=https://your-site/callback
# Keeps people signed in across restarts (any long random string, e.g. from: openssl rand -hex 32)
SESSION_SECRET=
